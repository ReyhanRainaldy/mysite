{
  "version": 2,
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "env": {
    "VERCEL_PHP_VERSION": "8.3",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:mQ3lAUJ2st/R1CxUJW79J8ee5MNNbtvUmceNoVrIl7c=",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/cv/(.*)",
      "dest": "/public/cv/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
